# Copa Draft — segredos da stack (copie para .env e preencha)
POSTGRES_PASSWORD=troque-esta-senha
# chave de assinatura dos JWTs (>= 32 chars aleatórios)
JWT_KEY=troque-por-uma-chave-aleatoria-longa-0123456789
# OAuth do Google (Cloud Console -> Credentials -> OAuth client id, tipo Web)
GOOGLE_CLIENT_ID=
# origem pública do site (usada no CORS; com o proxy nginx é a mesma do front)
PUBLIC_ORIGIN=http://localhost:8090
# porta exposta do front
WEB_PORT=8090
